{
  "name": "my-driven-development",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCode agents and contracts for planned, tracked and verified development",
  "type": "module",
  "bin": {
    "mdd": "dist/cli.js",
    "mdd-ai": "dist/cli.js"
  },
  "exports": {
    "./opencode-plugin": "./dist/opencode-plugin.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "scripts/setup.mjs",
    "assets/opencode",
    "README.md"
  ],
  "engines": {
    "node": ">=24.6.0 <25 || >=26.4.0 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --import ./tests/isolate-home.mjs --test tests/*.test.mjs",
    "mdd": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.22",
    "zod": "4.1.8"
  }
}
