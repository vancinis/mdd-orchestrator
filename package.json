{
  "name": "my-driven-development",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode-first planned development with native consent and grounded verification",
  "type": "module",
  "bin": {
    "mdd": "dist/cli.js",
    "mdd-ai": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/kernel.js",
    "./opencode-plugin": "./dist/opencode-plugin.js",
    "./opencode-tui": "./dist/opencode-tui.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "scripts/setup.mjs",
    "scripts/extract-engram.ps1",
    "assets/opencode",
    "README.md",
    "docs/*.md",
    "docs/mdd-config.schema.json"
  ],
  "engines": {
    "node": ">=24.6.0 <25 || >=26.4.0 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --import ./tests/isolate-home.mjs --test tests/*.test.mjs",
    "proof": "node dist/cli.js",
    "mdd": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@opentui/keymap": "0.5.14",
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.22",
    "@opencode/client": "2.0.22",
    "@opencode-ai/plugin": "1.18.31",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.12",
    "zod": "4.1.8"
  }
}
